{
  "routes": [
    {
      "route": "/dashboard.html",
      "allowedRoles": ["user", "sd"]
    },
    {
      "route": "/admin.html",
      "allowedRoles": ["sd"]
    },
    {
      "route": "/reports.html",
      "allowedRoles": ["sd"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/index.html",
      "statusCode": 302
    },
    "403": {
      "redirect": "/unauthorized.html",
      "statusCode": 302
    }
  }
}

